generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Tabla de usuarios de ElectroTransport
model EtUser {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  phone         String?
  role          String    @default("store")
  avatar        String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  store         EtStore?
  driver        EtDriver?
  ordersCreated EtOrder[]   @relation("CreatedBy")
  acceptedOrders EtOrder[]  @relation("AcceptedBy")

  @@map("EtUser")
}

/// Tabla de locales comerciales
model EtStore {
  id          String   @id @default(cuid())
  userId      String   @unique
  storeName   String
  storeType   String?
  address     String?
  city        String?
  lat         Float?
  lng         Float?
  rutNumber   String?
  description String?
  rating      Float    @default(0)
  totalOrders Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   EtUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders EtOrder[]

  @@map("EtStore")
}

/// Tabla de transportistas
model EtDriver {
  id            String   @id @default(cuid())
  userId        String   @unique
  vehicleType   String
  vehicleBrand  String?
  vehicleModel  String?
  vehicleYear   Int?
  vehiclePlate  String?
  licenseNumber String?
  driverLicense String?
  lat           Float?
  lng           Float?
  isOnline      Boolean  @default(false)
  rating        Float    @default(0)
  totalTrips    Int      @default(0)
  earnings      Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user EtUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("EtDriver")
}

/// Tabla de pedidos de transporte
model EtOrder {
  id              String    @id @default(cuid())
  orderNumber     String    @unique
  createdBy       String
  acceptedBy      String?
  storeId         String?
  status          String    @default("pending")

  originAddress   String
  originLat       Float
  originLng       Float
  destAddress     String
  destLat         Float
  destLng         Float

  cargoType       String?
  cargoWeight     Float?
  cargoQuantity   Int?
  cargoVolume     String?
  cargoImage      String?
  specialNotes    String?

  proposedPrice   Float
  acceptedPrice   Float?
  counterPrice    Float?
  distanceKm      Float?
  estimatedTime   Int?

  pickupDate      DateTime?
  deliveryDate    DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?

  ratingByStore   Float?
  ratingByDriver  Float?
  reviewByStore   String?
  reviewByDriver  String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  creator EtUser    @relation("CreatedBy", fields: [createdBy], references: [id])
  driver  EtUser?   @relation("AcceptedBy", fields: [acceptedBy], references: [id])
  store   EtStore?  @relation(fields: [storeId], references: [id])

  @@map("EtOrder")
}

/// Tabla de notificaciones
model EtNotification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  orderId   String?
  createdAt DateTime @default(now())

  @@map("EtNotification")
}
